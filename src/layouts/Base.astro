---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
export interface Props { title?: string; description?: string; }
const { title = 'Phongsakon Mark Konrad', description = 'ML researcher on the foundations of how models learn, and whether their representations capture the world\'s real causal structure or only imitate it.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function(){var t=localStorage.getItem('theme');if(!t)t=window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light';document.documentElement.setAttribute('data-theme',t)})();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/profile.png" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Nav />
    <main><slot /></main>
    <footer class="footer">
      <div class="container">
        <p>© {new Date().getFullYear()} Phongsakon Mark Konrad · Built from scratch with Astro · <a href="https://github.com/phomarkon/phomarkon.github.io">Source</a></p>
      </div>
    </footer>
  </body>
</html>
