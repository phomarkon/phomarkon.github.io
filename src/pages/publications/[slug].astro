---
import Base from '../../layouts/Base.astro';
import { publications } from '../../data/publications';

export function getStaticPaths() {
  return publications.map((p) => ({ params: { slug: p.slug }, props: { pub: p } }));
}

const { pub } = Astro.props as { pub: typeof publications[number] };

function fmtDate(d: string) {
  const [y, m] = d.split('-');
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  return `${months[parseInt(m,10)-1]} ${y}`;
}
---
<Base title={`${pub.title} · Phongsakon Mark Konrad`} description={pub.oneLine}>
  <section>
    <div class="container">
      <a href="/#publications" style="font-size:.85rem;color:var(--ink-mute);border:none">← All publications</a>
      <span class={`pub-venue ${pub.status === 'Under Review' ? 'submitted' : pub.status === 'Accepted' ? 'accepted' : pub.status === 'Published' ? 'published' : pub.status === 'Under Revision' ? 'revision' : pub.status === 'Preprint' ? 'preprint' : ''}`} style="margin-top:1.2rem; display:inline-block">{pub.venue} · {pub.status}</span>
      <h1 style="margin-top:.7rem">{pub.title}</h1>
      <p style="color:var(--ink-mute); margin-top:.5rem">{pub.authors} · {fmtDate(pub.date)}</p>

      <div class="pub-tags" style="margin-top:1.2rem">{pub.tags.map((t) => <span class="pub-tag">{t}</span>)}</div>

      <div style="margin-top:2rem; max-width:62ch">
        <h3 style="font-size:1rem; text-transform:uppercase; letter-spacing:.1em; color:var(--ink-mute); margin-bottom:.6rem">TL;DR</h3>
        <p style="color:var(--ink-soft); font-size:1.05rem">{pub.oneLine}</p>

        <h3 style="font-size:1rem; text-transform:uppercase; letter-spacing:.1em; color:var(--ink-mute); margin:2rem 0 .6rem">Abstract</h3>
        <p style="color:var(--ink-soft)">{pub.abstract}</p>
      </div>

      <div class="pub-links" style="margin-top:2rem; gap:1.5rem">
        {pub.pdf && <a href={pub.pdf} target="_blank" rel="noopener">PDF ↗</a>}
        {pub.code && <a href={pub.code} target="_blank" rel="noopener">Code ↗</a>}
        {pub.arxiv && <a href={pub.arxiv} target="_blank" rel="noopener">arXiv ↗</a>}
        {pub.doi && <a href={pub.doi} target="_blank" rel="noopener">DOI ↗</a>}
      </div>
    </div>
  </section>
</Base>
