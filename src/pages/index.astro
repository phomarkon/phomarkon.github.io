---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import ResearchLandscape from '../components/ResearchLandscape.astro';
import Highlights from '../components/Highlights.astro';
import Publications from '../components/Publications.astro';

const selectedSlugs = ['counterfactual-self-reports', 'decoded-but-unused', 'path-already-walked'];
import { publications } from '../data/publications';
const selectedPubs = selectedSlugs.map(s => publications.find(p => p.slug === s)!);
---
<Base>
  <!-- Hero / About -->
  <section id="about">
    <div class="container">
      <div class="hero-grid">
        <img src="/profile.png" alt="Phongsakon Mark Konrad" class="hero-photo" />
        <div>
          <h1 class="hero-name">Phongsakon <span class="brand-mark">Mark</span> Konrad</h1>
          <p class="hero-tag">anti big data big data guy · do models understand the world, or only imitate it</p>
          <div class="about">
            <p>A sushi chef learning his cuts, except the fish is a model. I take models apart by hand to see what is really happening inside.</p>
            <p>I am currently a Research Collaborator at <a href="https://www.sdu.dk/en/forskning/cis/laboratories/data-and-intelligence-lab">SDU's Data and Intelligence Lab</a> and at the <a href="https://hkust.edu.hk/">HKUST</a> DataVISards group, TA for AI at SDU (where I built an <a href="https://phomarkon.github.io/ai101/#/welcome" target="_blank" rel="noopener">interactive AI course</a>), and Founder of SaturoLabs. I have been admitted to the <a href="https://www.mlmi.eng.cam.ac.uk/">MPhil in Machine Learning and Machine Intelligence at the University of Cambridge</a>, which I begin this October. My research has been accepted at venues including ICML workshops, one as an oral, and I release code and model weights wherever I can.</p>
            <p class="rq-heading">What I work on</p>
            <p>I work on the foundations of how models learn. The thing I keep circling is how the learning process shapes the representations a model ends up with, and whether those representations capture the world's real causal structure or only imitate it. That puts me at the intersection of representation learning, causal representation learning, and the theory of learning, with <a href="/publications/counterfactual-self-reports">counterfactual reasoning</a> as my favourite test of whether a model understands or only pattern matches. I like to work phenomenon first, building small settings where I know the causal ground truth so I can watch <a href="/publications/decoded-but-unused">what learning actually recovers</a>. These questions sit under generalization, safety, and any real science of deep learning, because a model that only imitates causal structure breaks exactly where we most need it to hold.</p>
            <div class="rq-questions">
              <p class="rq-q"><span class="rq-qn">Q1</span>Does the learning process actually install representations capable of genuine counterfactual reasoning, or only ones that imitate it?</p>
              <p class="rq-q"><span class="rq-qn">Q2</span>And if it is only imitation, what would a learning process have to do differently to install the real thing?</p>
            </div>
            <p class="rq-fit">I am most drawn to groups working on the theory and mechanisms of representation learning, and I am always glad to talk through these questions.</p>
          </div>
          <div class="hero-social">
            <a href="mailto:phongsakon@outlook.dk">phongsakon@outlook.dk</a>
            <a href="https://scholar.google.com/citations?user=zPHjLREAAAAJ&hl=en" target="_blank" rel="noopener">Google Scholar ↗</a>
            <a href="https://github.com/phomarkon" target="_blank" rel="noopener">GitHub ↗</a>
            <a href="https://orcid.org/0009-0004-2521-7879" target="_blank" rel="noopener">ORCID ↗</a>
            <a href="https://www.linkedin.com/in/phongsakonmarkkonrad" target="_blank" rel="noopener">LinkedIn ↗</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected Work -->
  <section id="selected-work">
    <div class="container">
      <h2>Selected Work</h2>
      <p class="section-sub">A few papers that best represent my current research direction.</p>
      <div class="sw-section">
        {selectedPubs.map((p, i) => (
          <a class="sw-card" href={`/publications/${p.slug}`}>
            <span class="sw-num">{i + 1}</span>
            <div>
              <div class="sw-head">
                <span class="sw-title">{p.title}</span>
              </div>
              <div class="sw-authors">{p.authors}</div>
              <div class="sw-meta">
                <span class={`sw-venue-badge ${p.status === 'Under Review' ? 'submitted' : p.status === 'Accepted' ? 'accepted' : ''}`}>{p.status === 'Under Review' ? p.status : `${p.venue} · ${p.status}`}</span>
              </div>
              <p class="sw-tldr">{p.oneLine}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Research Landscape -->
  <section id="research">
    <div class="container-wide">
      <h2>Research Landscape</h2>
      <p class="section-sub">Three modalities, one through line. Hover a paper to see its neighbours light up. Click to open its page.</p>
      <ResearchLandscape />
    </div>
  </section>

  <!-- Publications -->
  <section id="publications">
    <div class="container">
      <h2>Publications</h2>
      <p class="section-sub">Peer reviewed and accepted work first, then preprints.</p>
      <Publications />
    </div>
  </section>

  <!-- BSc Thesis -->
  <section id="thesis">
    <div class="container">
      <h2>BSc Thesis</h2>
      <p class="section-sub">My bachelor thesis, with code and model weights released.</p>
      <article class="thesis-card">
        <h3 class="thesis-title">Heimdall: Only the Safe Shall Pass</h3>
        <p class="thesis-sub">A conformal verifier between autonomous bidders and the Nordic balancing market</p>
        <p class="thesis-blurb">With Tim Lukas Adam. Heimdall sits between LLM bidding agents and the grid, and it only lets a bid through if it stays above the operator's loss limit with the coverage they asked for. It holds that guarantee straight through the March 2025 rule change, and every accepted and rejected bid stays auditable.</p>
        <div class="thesis-meta">BSc thesis · conformal prediction · safety verification</div>
        <div class="thesis-links">
          <a href="https://github.com/phomarkon/heimdall-src" target="_blank" rel="noopener">Code ↗</a>
          <a href="https://huggingface.co/Phongsakon/heimdall" target="_blank" rel="noopener">Model weights ↗</a>
        </div>
      </article>
    </div>
  </section>

  <!-- Highlights -->
  <section id="highlights">
    <div class="container">
      <h2>Highlights</h2>
      <p class="section-sub">News, talks, and achievements, most recent first.</p>
      <Highlights />
    </div>
  </section>

  <!-- Career Timeline -->
  <section id="timeline">
    <div class="container-wide">
      <h2>Career Timeline</h2>
      <p class="section-sub">Where I've studied and worked, in chronological order.</p>
      <Timeline />
    </div>
  </section>

</Base>
