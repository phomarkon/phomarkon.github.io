---
import { highlights } from '../data/highlights';
---
<div class="hl-list">
  {highlights.map((h) => (
    <div class="hl-row">
      <span class="hl-date">{h.date}</span>
      <span class="hl-text">
        {h.href ? <a href={h.href} set:html={h.text} /> : <span set:html={h.text} />}
      </span>
    </div>
  ))}
</div>
