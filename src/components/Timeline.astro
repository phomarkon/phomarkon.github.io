---
import { timeline } from '../data/timeline';
---
<div class="timeline-wrap">
  <div class="timeline">
    {timeline.map((t) => (
      <div class={`tl-item ${t.position}`}>
        <div class="tl-card">
          <span class="ttl">{t.org}</span>
          <span class="sub">{t.role}</span>
          <span class="when">{t.when}</span>
          {t.note && <span class="note">{t.note}</span>}
        </div>
        <span class={`tl-dot ${t.future ? 'future' : ''}`}></span>
      </div>
    ))}
  </div>
</div>
