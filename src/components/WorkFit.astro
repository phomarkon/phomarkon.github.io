---
// "Questions I'm Chasing" — the three questions I keep circling, each shown with my own work on it.
// One theme underneath: does a model recover the world's causal structure, or only fit correlations?

interface Ref { label: string; href: string; }
interface Axis { axis: string; question: string; mine: Ref[]; }

const axes: Axis[] = [
  {
    axis: 'Identifiability',
    question: 'Does a self-report identify a self-model, or only describe behaviour in a prompt? When is the structure behind the data actually recoverable?',
    mine: [
      { label: 'Self-reports do not identify self-models', href: '/publications/counterfactual-self-reports' },
    ],
  },
  {
    axis: 'Causal vs. associational',
    question: 'Which representations recover the world’s causal structure, and which are merely decodable? Learning can install a feature that is readable yet never causally used.',
    mine: [
      { label: 'Decoded but unused', href: '/publications/decoded-but-unused' },
    ],
  },
  {
    axis: 'Achievable guarantees',
    question: 'When the quantity you care about is only partially identified, what can you certify, what coverage or robustness, before you authorise a model to act?',
    mine: [
      { label: 'Heimdall conformal verifier', href: '/#thesis' },
      { label: 'Acceptance Cards', href: '/publications/acceptance-cards' },
    ],
  },
];
---
<div class="fit-wrap">
  {axes.map((a) => (
    <article class="fit-card">
      <div class="fit-axis">{a.axis}</div>
      <p class="fit-q">{a.question}</p>
      <div class="fit-mine">
        <span class="fit-tag">My work</span>
        <div class="fit-refs">
          {a.mine.map((r) => (
            <a class="fit-ref mine" href={r.href}>{r.label}</a>
          ))}
        </div>
      </div>
    </article>
  ))}
</div>
