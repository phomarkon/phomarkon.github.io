---
import { nodes, edges as edgeList, SVG_W, SVG_H } from '../data/landscape';
import { publications } from '../data/publications';

const pubBySlug = Object.fromEntries(publications.map((p) => [p.slug, p]));
const nodeById = Object.fromEntries(nodes.map((n) => [n.id, n]));
const edges = edgeList;

const clusterMeta: Record<string, string> = {
  interp: 'Mechanistic Interpretability',
  safety: 'Safety & Evaluation',
  arch: 'AI Agents & Systems',
  medical: 'Medical Imaging',
  applied: 'Remote Sensing',
  viz: 'Human-AI',
};

const PAD = 55;
const LABEL_H = 22;
const mins: Record<string, { minX: number; minY: number; maxX: number; maxY: number }> = {};
for (const n of nodes) {
  if (!mins[n.cluster]) mins[n.cluster] = { minX: Infinity, minY: Infinity, maxX: -Infinity, maxY: -Infinity };
  const m = mins[n.cluster];
  m.minX = Math.min(m.minX, n.x); m.minY = Math.min(m.minY, n.y);
  m.maxX = Math.max(m.maxX, n.x); m.maxY = Math.max(m.maxY, n.y);
}
const regions = Object.entries(mins).map(([key, m]) => ({
  key,
  label: clusterMeta[key] || key,
  x: m.minX - PAD, y: m.minY - PAD - LABEL_H,
  w: m.maxX - m.minX + PAD * 2, h: m.maxY - m.minY + PAD * 2 + LABEL_H,
  labelX: (m.minX + m.maxX) / 2, labelY: m.minY - PAD,
}));

function curve(ax: number, ay: number, bx: number, by: number) {
  const mx = (ax + bx) / 2, my = (ay + by) / 2;
  const dx = bx - ax, dy = by - ay;
  const len = Math.hypot(dx, dy) || 1;
  const px = -dy / len, py = dx / len;
  const bow = Math.min(35, len * 0.08);
  return `M ${ax.toFixed(1)} ${ay.toFixed(1)} Q ${(mx + px * bow).toFixed(1)} ${(my + py * bow).toFixed(1)} ${bx.toFixed(1)} ${by.toFixed(1)}`;
}

const resolvedEdges = edges.map(([a, b]) => ({ a: nodeById[a], b: nodeById[b] })).filter((e) => e.a && e.b);
---
<div class="landscape" id="landscape-root" style={`--svgW:${SVG_W}; --svgH:${SVG_H};`}>
  <svg class="landscape-svg" viewBox={`0 0 ${SVG_W} ${SVG_H}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true">
    {regions.map((r) => (
      <g>
        <rect x={r.x} y={r.y} width={r.w} height={r.h} rx="16" fill={`var(--c-${r.key}-bg)`} stroke={`var(--c-${r.key})`} stroke-width="1.2" stroke-dasharray="6 4" opacity="0.5" />
        <text class="cluster-label" x={r.labelX} y={r.labelY} text-anchor="middle">{r.label}</text>
      </g>
    ))}
    <g class="ls-edges" fill="none">
      {resolvedEdges.map((e) => (
        <path d={curve(e.a.x, e.a.y, e.b.x, e.b.y)} data-a={e.a.id} data-b={e.b.id} />
      ))}
    </g>
  </svg>

  <div class="ls-nodes">
    {nodes.map((n) => {
      const label = n.pubSlug ? (pubBySlug[n.pubSlug]?.short ?? n.pubSlug) : (n.topic ?? '');
      const style = `left:${(n.x / SVG_W) * 100}%; top:${(n.y / SVG_H) * 100}%; --node-clr:var(--c-${n.cluster}); --node-bg:var(--c-${n.cluster}-bg);`;
      const cls = `ls-pill ${n.pubSlug ? '' : 'topic'}`;
      return n.pubSlug ? (
        <a class={cls} style={style} href={`/publications/${n.pubSlug}`} data-id={n.id} data-slug={n.pubSlug} aria-label={pubBySlug[n.pubSlug]?.title}>{label}</a>
      ) : (
        <span class={cls} style={style} data-id={n.id}>{label}</span>
      );
    })}
  </div>

  <div class="research-tooltip" id="ls-tip" role="tooltip">
    <div class="meta" id="ls-tip-meta"></div>
    <div class="ttl" id="ls-tip-title"></div>
    <div class="body" id="ls-tip-body"></div>
  </div>
</div>

<script type="module" define:vars={{
  pubBySlug: Object.fromEntries(publications.map((p) => [p.slug, { t: p.title, v: p.venue, s: p.status, o: p.oneLine }])),
  edgePairs: edges,
}}>
  const root = document.getElementById('landscape-root');
  const tip = document.getElementById('ls-tip');
  const tTitle = document.getElementById('ls-tip-title');
  const tMeta = document.getElementById('ls-tip-meta');
  const tBody = document.getElementById('ls-tip-body');

  const adj = new Map();
  for (const [a, b] of edgePairs) {
    if (!adj.has(a)) adj.set(a, new Set());
    if (!adj.has(b)) adj.set(b, new Set());
    adj.get(a).add(b); adj.get(b).add(a);
  }

  const pills = Array.from(root.querySelectorAll('.ls-pill'));
  const edgesEls = Array.from(root.querySelectorAll('.ls-edges path'));

  function focusNode(id) {
    const neighbours = adj.get(id) ?? new Set();
    neighbours.add(id);
    pills.forEach((p) => {
      const pid = p.getAttribute('data-id');
      p.classList.toggle('dim', !neighbours.has(pid));
      p.classList.toggle('hot', pid === id);
    });
    edgesEls.forEach((e) => {
      const ok = e.getAttribute('data-a') === id || e.getAttribute('data-b') === id;
      e.classList.toggle('hot', ok);
      e.classList.toggle('dim', !ok);
    });
  }
  function clearFocus() {
    pills.forEach((p) => p.classList.remove('dim', 'hot'));
    edgesEls.forEach((e) => e.classList.remove('dim', 'hot'));
  }

  pills.forEach((el) => {
    const id = el.getAttribute('data-id');
    const slug = el.getAttribute('data-slug');
    el.addEventListener('mouseenter', () => {
      focusNode(id);
      if (slug && pubBySlug[slug]) {
        const p = pubBySlug[slug];
        tTitle.textContent = p.t;
        tMeta.textContent = `${p.v} · ${p.s}`;
        tBody.textContent = p.o;
        tip.classList.add('show');
      }
    });
    el.addEventListener('mousemove', (e) => {
      tip.style.left = (e.clientX + 14) + 'px';
      tip.style.top = (e.clientY - 14) + 'px';
    });
    el.addEventListener('mouseleave', () => { clearFocus(); tip.classList.remove('show'); });
  });
</script>
